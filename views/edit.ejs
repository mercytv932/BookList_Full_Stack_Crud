<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
</head>

<body>

    <header class="navbar">

        <div class="logo">
            📚 Bookshelf
        </div>

        <a class="back-btn" href="/books">
            ← Back to Books
        </a>

    </header>

    <main class="form-container">

        <h1>Edit Book</h1>

        <form
            class="book-form"
            action="/books/<%= book._id %>?_method=PUT"
            method="POST"
        >

            <label for="title">Title</label>

            <input
                id="title"
                type="text"
                name="title"
                value="<%= book.title %>"
                required
            >

            <label for="author">Author</label>

            <input
                id="author"
                type="text"
                name="author"
                value="<%= book.author %>"
                required
            >

            <label class="checkbox-label">

                <input
                    type="checkbox"
                    name="completed"
                    <% if (book.completed === true) { %>
                        checked
                    <% } %>
                >

                Completed

            </label>

            <button type="submit">
                Save Changes
            </button>

        </form>

    </main>

</body>

</html>